# OptiDBX Environment Configuration
# Copy this file to .env and configure for your local environment

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

# PostgreSQL Connection Settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=optidbx
POSTGRES_USER=optidbx_user
POSTGRES_PASSWORD=optidbx_password

# Superuser credentials (only used by database/init_db.py for initial setup if needed)
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres

# Metric Collector Settings
METRIC_COLLECT_INTERVAL_SEC=5
