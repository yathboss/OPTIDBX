# OptiDBX Environment Configuration Example
# Copy this file to .env and configure local values

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

# PostgreSQL (Developer 2 / Shared Local Database)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=optidbx
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

